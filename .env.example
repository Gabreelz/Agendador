# Copie para .env e preencha:  cp .env.example .env
# O arquivo .env está no .gitignore. NUNCA o versione.

# --- Banco de dados (usado pelo docker-compose e pela aplicação) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=scheduler
DB_USER=scheduler
DB_PASSWORD=<defina-uma-senha>

# --- Usuário administrador da API (HTTP Basic) ---
APP_ADMIN_USER=admin
APP_ADMIN_PASSWORD=<defina-uma-senha>

# --- E-mail (dev aponta para o MailHog do docker-compose) ---
MAIL_HOST=localhost
MAIL_PORT=1025
# Apenas prod:
# MAIL_USERNAME=
# MAIL_PASSWORD=
